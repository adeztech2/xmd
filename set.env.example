# Copy this file to set.env for local development. Never commit set.env.
BOT_NAME=Nexus
PREFIX=.
OWNER_NUMBER=
MODE=public
PAIRING_NUMBER=
SESSION_ID=
AUTO_READ=false
CONNECT_ALERT=true
TIMEZONE=Africa/Nairobi

# Optional AI provider (choose one):
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Optional model override for the selected AI provider:
# AI_MODEL=

# Optional GitHub token for higher API rate limits:
# GITHUB_TOKEN=
